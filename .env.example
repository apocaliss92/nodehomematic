# Template per i test end-to-end contro una CCU3/RaspberryMatic reale.
# Copia in `.env` (gitignored) e compila i valori:  cp .env.example .env
# I test/script leggono queste variabili con `node --env-file=.env` (nativo Node 20+).

# Abilita i test e2e (altrimenti vengono saltati). 1 = abilitati.
HM_E2E=0

# Indirizzo della CCU (host/IP, senza schema http://).
HM_HOST=192.168.1.XX

# Credenziali WebUI CCU (usate dal client JSON-RPC).
HM_USERNAME=Admin
HM_PASSWORD=

# true se la CCU usa HTTPS (porte TLS 42001/42010 e WebUI 443).
HM_TLS=false

# Interfacce XML-RPC attive sulla CCU, separate da virgola.
HM_INTERFACES=HmIP-RF,BidCos-RF

# IP di QUESTA macchina, raggiungibile DALLA CCU: la CCU fa push degli eventi
# verso il callback server in ascolto qui. Non usare localhost se sono host diversi.
HM_CALLBACK_HOST=192.168.1.YY

# Porta libera su cui il callback server XML-RPC resta in ascolto.
HM_CALLBACK_PORT=9123
